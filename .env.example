# Copy to .env.local for local development.

# Prism's own database (see docker-compose.yml).
DATABASE_URL=postgres://prism:prism@localhost:54329/prism

# The gateway sends X-User-Id and X-Gateway-Secret on every request.
# Required in production (32+ characters). Leave unset locally to skip the
# check and act as DEV_USER_ID (or whatever X-User-Id a request sends).
# GATEWAY_SHARED_SECRET=

# Development only: the user when no gateway is in front of the app.
DEV_USER_ID=dev-user

# Secret storage. When KMS_KEY_ID is set, keys are sealed with AWS KMS
# (not implemented yet). Unset locally: keys are stored unencrypted, which
# production refuses.
# KMS_KEY_ID=
