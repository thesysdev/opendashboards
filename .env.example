# Copy to .env.local for local development.
#
# Settings (URLs, model, timeouts, the local dev user…) live in config/:
# common.ts, plus local.ts or prod.ts. `next dev` and tests run as local,
# production builds and `next start` as prod. This file is only for secrets;
# next.config.ts refuses to start a server that's missing one it needs.

# Our database: OpenDashboards' own data (users' connections, apps,
# dashboards). The only database we write to; every build migrates it. Locally
# it's docker-compose.yml's Postgres. On Vercel, the Neon integration sets this
# to our Neon project's pooled URL and DATABASE_URL_UNPOOLED to its direct one.
DATABASE_URL=postgres://opendashboards:opendashboards@localhost:54329/opendashboards

# The gateway sends the user's Supabase access token (Authorization: Bearer)
# on every request. SUPABASE_URL is the project that issues it, required in
# prod. Leave it unset locally to skip the check and act as config/local.ts's
# dev user.
# SUPABASE_URL=

# Secret storage. When KMS_KEY_ID is set, keys are sealed with AWS KMS. Unset
# locally: keys are stored unencrypted, which prod refuses. KMS_ROLE_ARN is the
# role assumed through Vercel OIDC; required in prod.
# KMS_KEY_ID=
# KMS_ROLE_ARN=

# Demo data: the password of the read-only role on the shared "Demo Data" Neon
# project (config/common.ts demoData). Read-only, shared with other apps: we
# never write to it. Required in prod. Unset locally: demo datasets aren't
# offered.
# DEMO_DATABASE_PASSWORD=

# Product analytics: the PostHog project key for Thesys' own deployment, set
# on Vercel for Production only. Not a secret, but leave it unset everywhere
# else: without it, neither the browser nor the server sends any events.
# NEXT_PUBLIC_POSTHOG_KEY=
# Billing (optional: leave unset to disable billing and limits). Set the Stripe
# price and portal ids printed by `scripts/stripe-setup.mjs`, plus Stripe's API
# key and the signing secret of the webhook at /api/stripe/webhook (locally,
# `stripe listen --forward-to localhost:3100/api/stripe/webhook` prints one).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STANDARD_MONTHLY=
# STRIPE_PRICE_STANDARD_ANNUAL=
# STRIPE_PORTAL_STANDARD_MONTHLY=
# STRIPE_PORTAL_STANDARD_ANNUAL=
# STRIPE_PRICE_TEAM_MONTHLY=
# STRIPE_PRICE_TEAM_ANNUAL=
# STRIPE_PORTAL_TEAM_MONTHLY=
# STRIPE_PORTAL_TEAM_ANNUAL=
# STRIPE_PORTAL_TEAM_SEATS=

# Google Ads and Meta Ads sign in through Composio (Composio-managed OAuth
# apps) for now. COMPOSIO_API_KEY is the Composio project's API key, with the
# least it needs: write on connected accounts (sign-in links, deleting
# accounts) and on tool execution (running the read tools), nothing else. The
# two auth config ids (ac_…) come from Composio's dashboard: Auth Configs →
# create one for Google Ads and one for Meta Ads with Composio-managed auth.
# Give the Meta one `ads_read` only, not `ads_management`. Google Ads has no
# read-only scope, so there only the sources' read-only tool list guards it.
# Unset: those two sources say they aren't set up, and nothing else changes.
# COMPOSIO_API_KEY=…
# COMPOSIO_GOOGLEADS_AUTH_CONFIG_ID=…
# COMPOSIO_METAADS_AUTH_CONFIG_ID=…
