{
  "name": "@opendashboards/dashboard-kit",
  "version": "0.0.1",
  "description": "An OpenUI Lang component library for polished analytics dashboards: KPIs with period comparison, time series, funnels, cohorts, tables and filters.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsdown && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "prompt": "node scripts/print-prompt.mjs"
  },
  "peerDependencies": {
    "@openuidev/react-lang": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "d3-geo": "^3.1.2",
    "recharts": "^3.8.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@openuidev/react-lang": "^1.1.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "^0.16.0",
    "typescript": "^5",
    "zod": "^4.6.7"
  }
}
